{
  "schemaVersion": 1,
  "id": "chunkanimator",
  "version": "${version}",
  "name": "Chunk Animator",
  "description": "A small client side mod that animates the appearance of chunks so that they don't just instantly appear. Works with Minecraft's renderer, Sodium and Iris.",
  "authors": [
    "Lumien"
  ],
  "contributors": [
    "Harley O'Connor",
    "Romoslayer"
  ],
  "contact": {
    "homepage": "https://github.com/Romoslayer/ChunkAnimator-Fabric",
    "sources": "https://github.com/Romoslayer/ChunkAnimator-Fabric",
    "issues": "https://github.com/Romoslayer/ChunkAnimator-Fabric/issues"
  },
  "license": "MIT",
  "icon": "assets/chunkanimator/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "lumien.chunkanimator.ChunkAnimator"
    ],
    "modmenu": [
      "lumien.chunkanimator.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "chunkanimator.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_range}",
    "java": ">=25",
    "fabric-command-api-v2": "*",
    "fabric-lifecycle-events-v1": "*"
  },
  "suggests": {
    "sodium": "*",
    "modmenu": "*"
  },
  "breaks": {
    "sodium": "<0.9.0"
  }
}
